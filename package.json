{
  "name": "react-word-editor",
  "version": "0.4.2",
  "description": "An embeddable, browser-local DOCX editor for React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.d.css.ts",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "converter/server.py",
    "converter/Dockerfile",
    "compose.yaml"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "dev:word": "docker compose up --build -d word-converter && vite",
    "converter:start": "docker compose up --build -d word-converter",
    "converter:stop": "docker compose stop word-converter",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config vite.library.ts && tsc -p tsconfig.build.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/style.d.css.ts', 'dist/style.d.css.ts')\"",
    "build:demo": "vite build --outDir demo-dist",
    "prepack": "npm run build",
    "test": "playwright test",
    "test:precommit": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
